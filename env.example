OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Firecrawl (optional but recommended for web enrichment)
# Get an API key from Firecrawl and set it here
FIRECRAWL_API_KEY=your-firecrawl-key
PORT=8000

# Catalog storage
# Default is JSON fallback from app/catalog.json.
# Use sqlite for a zero-cost local database, or supabase for a free hosted Postgres project.
SHOE_CATALOG_BACKEND=json
SHOE_SQLITE_PATH=data/running_shoes.db

# Supabase hosted database (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Prefer service role only for server-side scraper upserts. Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SHOES_TABLE=running_shoes

# Compressed thumbnail limits for scraper image storage
SHOE_IMAGE_MAX_BYTES=45000
